# Copy this file to .env for local (XAMPP) use. On Render, add these in Environment settings instead.
# NEVER commit your real .env file.

APP_URL=http://localhost/mood-buddy
APP_DEBUG=false

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=moodbuddy
DB_USER=root
DB_PASS=
# true for cloud MySQL (Aiven, TiDB Cloud). false on XAMPP.
DB_SSL=false

# This user becomes admin automatically on login
ADMIN_EMAIL=

# --- AI / APIs (all optional - site has fallbacks) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
HF_API_KEY=
YOUTUBE_API_KEY=

# --- Email (optional; without it, new accounts are activated directly) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=MoodBuddy
